fn swap(T, U)(T: a, U: b):
    return (b, a)

fn main():
    let t = (1, "hi")
    match t:
        try (a, b):
            println(a)
            println(b)

    let n = (10, (20, 30))
    match n:
        try (x, (y, z)):
            println(x + y + z)

    let w = (7, "seven")
    match w:
        catch:
            println("wildcard")

    let s = swap(1, 2)
    match s:
        try (b, a):
            println(a)
            println(b)
