fn main():
    let str: path = "examples/fs_demo2/note.txt"
    let bool: wrote = fs.write(path, "hello lime fs\n")
    println(wrote)
    let bool: exists = fs.exists(path)
    println(exists)
    let FileMetadata: meta = fs.metadata(path)
    println(meta.size)
    println(meta.is_file)
    let int: sz = fs.size(path)
    println(sz)
    let bool: made = fs.create_dir("examples/fs_demo2/sub")
    println(made)
    let List(str): entries = fs.list_dir("examples/fs_demo2")
    println(entries)
    let bool: removed = fs.remove(path)
    println(removed)
    return
