// std.json: JSON parsing, serialization, and manipulation
// Wraps runtime builtins for first-class Json type support.

// Parse a JSON string into a Json value
fn parse(str: text):
    return json_parse(text)

// Serialize a Json value to a JSON string
fn stringify(json: v):
    return json_stringify(v)

// Get a value from a Json object by key; returns Option(Json)
fn get(json: obj, str: key):
    return json_get(obj, key)

// Check if a Json object has a key
fn has(json: obj, str: key):
    return json_has(obj, key)

// Get the length of a Json array, object, or string
fn len(json: v):
    return json_len(v)

// Get an element from a Json array by index
fn at(json: arr, int: index):
    return json_at(arr, index)

// Convert a Json value to a string
fn as_string(json: v):
    return json_as_string(v)

// Convert a Json value to an integer
fn as_int(json: v):
    return json_as_int(v)

// Convert a Json value to a float
fn as_float(json: v):
    return json_as_float(v)

// Convert a Json value to a boolean
fn as_bool(json: v):
    return json_as_bool(v)

// Create a null Json value
fn null():
    return json_null()

// Create an empty Json object
fn object():
    return json_object()

// Create an empty Json array
fn array():
    return json_array()

// Set a key-value pair on a Json object
fn set(json: obj, str: key, json: value):
    return json_set(obj, key, value)

// Push a value onto a Json array
fn push(json: arr, json: elem):
    return json_push(arr, elem)
