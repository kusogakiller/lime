// std.result: Result(T, E) helpers
// Result(T, E) uses Success/Error variants.
// Public API uses extract/extract_or naming.

// Extract the value from Success, or return fallback for Error.
fn extract_or(T, E)(Result(T, E): res, T: fallback):
    return result_extract_or(res, fallback)

// Check if the result is Success.
fn is_ok(T, E)(Result(T, E): res):
    return result_is_success(res)

// Check if the result is Error.
fn is_err(T, E)(Result(T, E): res):
    return result_is_error(res)

// Extract the value from Success. Panics on Error.
fn extract(T, E)(Result(T, E): res):
    return result_extract(res)

// Backward-compatible aliases
fn unwrap_or(T, E)(Result(T, E): res, T: fallback):
    return result_extract_or(res, fallback)

fn unwrap(T, E)(Result(T, E): res):
    return result_extract(res)
