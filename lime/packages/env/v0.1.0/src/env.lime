/// Environment variable utilities for Lime.
/// Provides access to the current process environment.

/// Get an environment variable. Returns Option(String).
/// Returns Some(value) if the variable exists, None otherwise.
fn get(str: key):
    return env_get(key)

/// Check if an environment variable exists.
fn has(str: key):
    return env_has(key)

/// Set an environment variable.
/// Returns true on success, false on failure.
fn set(str: key, str: value):
    return env_set(key, value)

/// Remove an environment variable.
/// Returns true on success, false on failure.
fn remove(str: key):
    return env_remove(key)

/// Return all environment variables as a Map(str, str).
/// NOTE: Native codegen returns an empty map due to encoding limitations.
/// The interpreter returns the full environment.
fn all():
    return env_all()
