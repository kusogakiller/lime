// std.time: time utilities (Phase 12 Step 1).
// Instant/Duration are plain structs wrapping a float epoch-seconds value;
// the actual clock/sleep are runtime builtins (time_now/time_sleep).

// A point in time (seconds since the Unix epoch).
struct Instant:
    float: secs

// A span of time, in seconds.
struct Duration:
    float: secs

// Current time as an Instant.
fn now():
    let float: f = time_now()
    return Instant(f)

// Seconds elapsed since `start`.
fn elapsed(Instant: start):
    let float: f = time_now() - start.secs
    return Duration(f)

// Sleep for `secs` seconds. Returns true.
fn sleep(float: secs):
    return time_sleep(secs)
