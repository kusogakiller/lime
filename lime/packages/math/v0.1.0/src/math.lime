// std.math: 数学ユーティリティ
// ランタイム組込み（abs/min/max/clamp/sqrt/pow/floor/ceil/round/
//   trunc/exp/log/log10/sin/cos/tan/asin/acos/atan/pi/e）をラップする。

// 絶対値
fn abs(float: x):
    return abs(x)

// 最小値
fn min(float: a, float: b):
    return min(a, b)

// 最大値
fn max(float: a, float: b):
    return max(a, b)

// クランプ（lo <= x <= hi に収める）
fn clamp(float: x, float: lo, float: hi):
    return clamp(x, lo, hi)

// 平方根
fn sqrt(float: x):
    return sqrt(x)

// 累乗
fn pow(float: a, float: b):
    return pow(a, b)

// 床関数（切り捨て）
fn floor(float: x):
    return floor(x)

// 天井関数（切り上げ）
fn ceil(float: x):
    return ceil(x)

// 四捨五入
fn round(float: x):
    return round(x)

// 切り詰め（ゼロ方向）
fn trunc(float: x):
    return trunc(x)

// 指数関数 e^x
fn exp(float: x):
    return exp(x)

// 自然対数 ln(x)
fn log(float: x):
    return log(x)

// 常用対数 log10(x)
fn log10(float: x):
    return log10(x)

// 正弦関数
fn sin(float: x):
    return sin(x)

// 余弦関数
fn cos(float: x):
    return cos(x)

// 正接関数
fn tan(float: x):
    return tan(x)

// 逆正弦関数
fn asin(float: x):
    return asin(x)

// 逆余弦関数
fn acos(float: x):
    return acos(x)

// 逆正接関数
fn atan(float: x):
    return atan(x)

// 円周率 π
fn pi():
    return math_pi()

// 自然対数の底 e
fn e():
    return math_e()
