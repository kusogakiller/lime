// std.string: string utilities.
// The low-level operations (len/contains/starts_with/ends_with/trim/replace/
// split/slice) are provided both as runtime builtins and as package wrappers so
// the package exposes a stable, documented surface.

// Number of Unicode characters.
fn len(str: s):
    return len(s)

// Number of bytes.
fn byte_len(str: s):
    return s.byte_len()

// Whether `sub` occurs inside `s`.
fn contains(str: s, str: sub):
    return contains(s, sub)

// Whether `s` starts with `prefix`.
fn starts_with(str: s, str: prefix):
    return starts_with(s, prefix)

// Whether `s` ends with `suffix`.
fn ends_with(str: s, str: suffix):
    return ends_with(s, suffix)

// Trim leading/trailing whitespace.
fn trim(str: s):
    return trim(s)

// Replace every occurrence of `from` with `to`.
fn replace(str: s, str: from, str: to):
    return replace(s, from, to)

// Split `s` on `sep` into List(str).
fn split(str: s, str: sep):
    return split(s, sep)

// Substring [start, end).
fn slice(str: s, int: start, int: end):
    return s.slice(start, end)

// ===== Phase 12 Step 1 extensions =====

// Uppercase.
fn to_upper(str: s):
    return to_upper(s)

// Lowercase.
fn to_lower(str: s):
    return to_lower(s)

// Repeat `s` `times` times.
fn repeat(str: s, int: times):
    return repeat(s, times)

// ===== Phase B-3: extended string APIs =====

// Whether the string is empty.
fn is_empty(str: s):
    return is_empty(s)

// Byte offset of the first occurrence of `sub`, or -1.
fn find(str: s, str: sub):
    return find(s, sub)

// Number of non-overlapping occurrences of `sub`.
fn count(str: s, str: sub):
    return count(s, sub)

// Trim leading whitespace.
fn trim_start(str: s):
    return trim_start(s)

// Trim trailing whitespace.
fn trim_end(str: s):
    return trim_end(s)

// Join a List(str) with `sep` between each element.
fn join(str: sep, list(str): parts):
    return join(sep, parts)

// Parse the string as a signed integer. Returns 0 on failure.
fn to_int(str: s):
    return to_int(s)

// Parse the string as a float. Returns 0.0 on failure.
fn to_float(str: s):
    return to_float(s)

// Case-sensitive equality.
fn equals(str: s, str: other):
    return equals(s, other)

// Lexicographic comparison. Returns -1, 0, or 1.
fn compare(str: s, str: other):
    return compare(s, other)
