// std.io: Input/output utilities for Lime 1.0.
// Core print/println/input are provided as runtime builtins.
// This package wraps them and adds eprint, eprintln, read_line,
// read_all, write_stdout, write_stderr.

// ===== Output =====

// Print to stdout without trailing newline.
fn print(str: s):
    print(s)

// Print to stdout with trailing newline.
fn println(str: s):
    println(s)

// Print to stderr without trailing newline.
fn eprint(str: s):
    eprint(s)

// Print to stderr with trailing newline.
fn eprintln(str: s):
    eprintln(s)

// ===== Input =====

// Read one line from stdin (no prompt). Strips trailing newline.
fn read_line():
    return io_read_line()

// Read all remaining input from stdin until EOF.
fn read_all():
    return io_read_all()

// Read one line from stdin with a prompt. Strips trailing newline.
fn prompt(str: message):
    return input(message)

// ===== Low-level =====

// Write a string directly to stdout. Returns true on success.
fn write_stdout(str: s):
    return io_write_stdout(s)

// Write a string directly to stderr. Returns true on success.
fn write_stderr(str: s):
    return io_write_stderr(s)
