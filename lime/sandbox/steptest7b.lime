# Step 7 Phase 2: Operator Interface resolution (static / AST-stored).
# User-defined Vec2 implicitly implements Add / Equal / Compare,
# and + == != < > <= >= resolve via Operator Interface.

interface Add(T):
    fn add(T): T:

interface Equal(T):
    fn equal(T): bool:

interface Compare(T):
    fn compare(T): int:

struct Vec2:
    int: x
    int: y
    fn add(Vec2: other): Vec2:
        Vec2(x + other.x, y + other.y)
    fn equal(Vec2: other): bool:
        x == other.x and y == other.y
    fn compare(Vec2: other): int:
        if x < other.x:
            0 - 1
        else:
            if x > other.x:
                1
            else:
                if y < other.y:
                    0 - 1
                else:
                    if y > other.y:
                        1
                    else:
                        0

let a = Vec2(1, 2)
let b = Vec2(3, 4)
let c = Vec2(1, 2)

let s = a + b
print(s.x)
print(s.y)

print(a == c)
print(a == b)
print(a != b)

print(a < b)
print(b > a)
print(a <= c)
print(b >= a)

let i = 10 + 20
print(i)
print(3 < 5)
