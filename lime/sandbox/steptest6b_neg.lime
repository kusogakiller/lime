# Negative case for Step 6 Phase 2:
# max requires T: Compare, but int does NOT implement the user Compare interface.
# Expect a compile-time Type error.

interface Compare(T):
    fn compare(T): int:

fn max(List(T where T: Compare): xs): T:
    let best = xs.get(0)
    let i = 1
    while i < xs.len():
        let cur = xs.get(i)
        if cur > best:
            best = cur
        i = i + 1
    best

let v = [1, 3, 2]
let m = max(v)
print(m)
