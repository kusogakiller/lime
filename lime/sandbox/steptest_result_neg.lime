# Result の Match 完全網羅チェック（負例）。Error 腕を省略 → コンパイルエラー。
# Ok/Err は使わず Success / Error を使用。

fn divide(int: a, int: b): Result(int, str):
    if b == 0:
        Error("div0")
    else:
        Success(a / b)

let r = divide(1, 0)
match r:
    Success(s):
        print(s)
    # Error 腕がない → 不完全網羅で型エラーになるはず
