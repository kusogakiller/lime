fn id<T>(x: T) -> T { return x }
fn pair<T>(a: T, b: T) -> List<T> { let l: List<T> = List(); l.push(a); l.push(b); return l }
fn get<K,V>(m: HashMap<K,V>, k: K) -> V { return m.get(k) }
fn len_<T>(l: List<T>) -> int { return l.size() }

