fn main():
    let int?: x = Some(5)
    match x:
        Some(v):
            print(v)
        None:
            print(0)

    let int?: y = None
    match y:
        Some(v):
            print(v)
        None:
            print("none")

    let Option(str): z = Some("hello")
    match z:
        Some(s):
            print(s)
        None:
            print("none")
