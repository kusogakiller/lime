# Result(T, E) 基盤テスト (Step: built-in Result via State + Generic machinery).
# Ok/Err は使わず Success / Error を使用。Match 完全網羅必須・else禁止・Ignore維持。
#
# 期待出力:
#   10
#   error: divide by zero
#   10
#   42
#   10

# Result は特別構文ではなく、既存の State + Generic 仕組みで提供される。
# 利用側は state 宣言不要。

fn divide(int: a, int: b): Result(int, str):
    if b == 0:
        Error("divide by zero")
    else:
        Success(a / b)

fn describe(Result(int, str): r): str:
    match r:
        Success(s):
            s
        Error(e):
            e

let r1 = divide(20, 2)
match r1:
    Success(s):
        print(s)
    Error(e):
        print(e)

let r2 = divide(1, 0)
match r2:
    Success(s):
        print(s)
    Error(e):
        print("error: " + e)

# Result を Option と同じ扱いで関数の戻り値・引数として利用。
fn unwrap_or(Result(int, str): r, int: fallback): int:
    match r:
        Success(s):
            s
        Error(Ignore):
            fallback

print(unwrap_or(r1, 0))
print(unwrap_or(r2, 42))

# describe は Result(int, str) を受け取り string 化（標準ライブラリ風の基盤利用）。
print(describe(r1))

