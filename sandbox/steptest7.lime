interface Animal:
    fn speak(str): str:
    fn legs(): int:

struct Dog implements Animal:
    str: name
    int: legs
    fn speak(str): str:
        return "woof"
    fn legs(): int:
        return 4

struct Cat implements Animal:
    str: name
    int: legs
    fn speak(str): str:
        return "meow"
    fn legs(): int:
        return 4

fn make_sound(Animal: a):
    print(a.speak(""))

fn main():
    let d = Dog("Rex", 4)
    print(d.speak(""))
    print(d.legs())

    let c = Cat("Mimi", 4)
    print(c.speak(""))

    make_sound(d)
    make_sound(c)
