// std.math: 数学ユーティリティ
// ランタイム組込み（abs/min/max/clamp/sqrt/pow/floor/ceil/round）をラップする。

// 絶対値
fn abs(float: x):
    return abs(x)

// 最小値
fn min(float: a, float: b):
    return min(a, b)

// 最大値
fn max(float: a, float: b):
    return max(a, b)

// クランプ（lo <= x <= hi に収める）
fn clamp(float: x, float: lo, float: hi):
    return clamp(x, lo, hi)

// 平方根
fn sqrt(float: x):
    return sqrt(x)

// 累乗
fn pow(float: a, float: b):
    return pow(a, b)

// 床関数（切り捨て）
fn floor(float: x):
    return floor(x)

// 天井関数（切り上げ）
fn ceil(float: x):
    return ceil(x)

// 四捨五入
fn round(float: x):
    return round(x)
