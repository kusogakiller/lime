// std.option: Option(T) helpers
// Option(T) is a language builtin (Some(x) / None).
// Public API uses extract/extract_or naming.

// Extract the value from Some, or return fallback for None.
fn extract_or(T)(Option(T): opt, T: fallback):
    return option_extract_or(opt, fallback)

// Check if the option is Some.
fn is_some(T)(Option(T): opt):
    return option_is_some(opt)

// Check if the option is None.
fn is_none(T)(Option(T): opt):
    return option_is_none(opt)

// Extract the value from Some. Panics on None.
fn extract(T)(Option(T): opt):
    return option_extract(opt)

// Backward-compatible aliases
fn unwrap_or(T)(Option(T): opt, T: fallback):
    return option_extract_or(opt, fallback)

fn unwrap(T)(Option(T): opt):
    return option_extract(opt)
