// std.fs: filesystem utilities.
// The low-level operations (read_file/write_file/append_file/file_exists/
// remove_file) are provided as runtime builtins. These wrappers give the
// package a stable, documented surface.

// Metadata about a filesystem entry, as returned by `metadata`/`size`.
struct FileMetadata:
    int: size
    bool: is_dir
    bool: is_file

// Read an entire file into a string.
fn read(str: path):
    return read_file(path)

// Overwrite a file with the given contents. Returns true on success.
fn write(str: path, str: content):
    return write_file(path, content)

// Append contents to a file (creating it if needed). Returns true on success.
fn append(str: path, str: content):
    return append_file(path, content)

// Whether a path exists on disk.
fn exists(str: path):
    return file_exists(path)

// Delete a file. Returns true on success.
fn remove(str: path):
    return remove_file(path)

// ===== Phase 12 Step 1 extensions =====

// Return a FileMetadata struct for the path (size in bytes, is_dir, is_file).
fn metadata(str: path):
    return fs_metadata(path)

// Size of a file (or directory) in bytes.
fn size(str: path):
    return fs_size(path)

// List the immediate children of a directory as List(str) of full paths.
fn list_dir(str: path):
    return fs_list_dir(path)

// Create a directory (and any missing parents). Returns true on success.
fn create_dir(str: path):
    return fs_create_dir(path)

// ===== Phase C-1.3 extensions =====

// Copy a file from src to dst. Returns true on success.
fn copy(str: src, str: dst):
    return fs_copy(src, dst)

// Rename or move a file from src to dst. Returns true on success.
fn rename(str: src, str: dst):
    return fs_rename(src, dst)

// Whether path is a regular file.
fn is_file(str: path):
    return fs_is_file(path)

// Whether path is a directory.
fn is_dir(str: path):
    return fs_is_dir(path)

// Remove an empty directory. Returns true on success.
fn remove_dir(str: path):
    return fs_remove_dir(path)

// Read a file and return its contents as a list of lines (without newlines).
fn read_lines(str: path):
    return fs_read_lines(path)

// Write a list of lines to a file, each followed by a newline. Returns true on success.
fn write_lines(str: path, list(str): lines):
    return fs_write_lines(path, lines)
