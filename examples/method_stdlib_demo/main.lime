// citrusstrates the unified method-form stdlib API (no std. prefix, no
// module-function calls). All operations are non-mutating: methods return new
// values, so bindings are reassigned.

fn main():
    // ---- List ----
    let List(int): nums = []
    nums = nums.push(1)
    nums = nums.push(2)
    nums = nums.push(3)
    println(nums.length())
    println(nums.first())
    println(nums.last())
    println(nums.contains(2))
    println(nums.index_of(2))
    println(nums.reverse())

    // ---- HashMap ----
    let HashMap(str, int): scores = collections.make_hash_map()
    scores = scores.insert("math", 95)
    scores = scores.insert("english", 88)
    println(scores.get("math"))
    println(scores.contains("math"))
    println(scores.length())

    // ---- HashSet ----
    let HashSet(str): tags = collections.make_hash_set()
    tags = tags.add("compiler")
    tags = tags.add("language")
    println(tags.contains("compiler"))
    println(tags.length())

    // ---- Time ----
    let Instant: start = time.now()
    let Duration: d = start.elapsed()
    println(d.secs)

    // ---- File System (path is a str with file methods) ----
    let str: path = "method_stdlib_demo_out.txt"
    path.write("hello lime")
    if path.exists():
        let meta = path.metadata()
        println(meta.size)
    path.remove()

    // ---- String ----
    let str: text = "Hello Lime"
    println(text.to_upper())
    println(text.to_lower())
    println(text.repeat(3))
    println(text.length())

    // ---- Math (on Float values) ----
    let float: value = -3.14
    println(value.abs())
    let float: r = 9.0
    println(r.sqrt())
