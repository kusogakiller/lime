// Inference demo: verify that untyped parameters are inferred from call
// sites and body constraints, making type-checking, codegen, and execution
// succeed without explicit type annotations.

fn add(a, b):
    return a + b

fn identity(value):
    return value

fn add_one(x):
    return x + 1

fn main():
    // Test 1: simple param inference from call site
    let x = add(1, 2)
    println(x)

    // Test 2: identity preserves type
    let y = identity(100)
    println(y)

    // Test 3: add_one with literal
    let z = add_one(41)
    println(z)

    // Test 4: chained inference (identity of add result)
    let w = identity(add(10, 20))
    println(w)

    // Test 5: string identity
    let s = identity("hello")
    println(s)

    // Test 6: add_one on another literal
    let a = add_one(99)
    println(a)
