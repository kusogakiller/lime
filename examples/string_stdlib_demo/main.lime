import std.string

fn main():
    let s = "  Hello, Lime  "
    
    println("=== Trim ===")
    println(std.string.trim(s))
    println(std.string.trim_start(s))
    println(std.string.trim_end(s))
    
    println("=== Search ===")
    println(std.string.contains("hello", "ell"))
    println(std.string.find("hello", "ll"))
    println(std.string.count("hello", "l"))
    println(std.string.is_empty(""))
    println(std.string.is_empty("a"))
    
    println("=== Case ===")
    println(std.string.to_upper("abc"))
    println(std.string.to_lower("ABC"))
    
    println("=== Join / Split ===")
    let parts = std.string.split("a,b,c", ",")
    println(std.string.join("-", parts))
    
    println("=== Conversion ===")
    println(std.string.to_int("42"))
    println(std.string.to_int("abc"))
    println(std.string.to_float("3.14"))
    println(std.string.to_float("xyz"))
    
    println("=== Comparison ===")
    println(std.string.equals("a", "a"))
    println(std.string.equals("a", "b"))
    println(std.string.compare("a", "b"))
    println(std.string.compare("b", "a"))
    println(std.string.compare("a", "a"))
    
    return