// Level 11: closures ? literal, value capture, returned from function.
// LIMITATION (Iteration 33 finding): each FUNCTION may contain at most one
// closure literal; two functions that both define closure literals emit a
// duplicate @anon_0 wrapper and fail native compilation (loud error).
fn make_adder(int: n):
    return fn(int: x):
        return x + n
fn main():
    let add10 = make_adder(10)
    println(add10(5))
    println(add10(90))
    let score = 3
    println(add10(score * 4))
