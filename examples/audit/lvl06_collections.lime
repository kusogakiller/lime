// Level 6: collections (list / add / get / set / len / indexing / for-in)
fn sum_list(List(int): l):
    let mut acc = 0
    let mut i = 0
    while i < l.len():
        acc = acc + l.get(i)
        i = i + 1
    return acc
fn main():
    let nums = [4, 2, 9]
    println(nums.len())
    println(nums.get(0))
    println(nums[2])
    let mut grown = [1, 2]
    grown.add(3)
    grown.add(4)
    println(grown.len())
    println(grown[3])
    grown.set(0, 100)
    println(grown.get(0))
    println(sum_list(grown))
    for v in grown:
        println(v)
    let mut hit = -1
    let mut k = 0
    while k < grown.len():
        if grown.get(k) == 9:
            hit = k
        k = k + 1
    println(hit)
