// ============================================================
// FINAL — Task Manager (integrated manual-audit program)
// Iteration 33 audit edition.
//
// Verified-native feature set used:
//   structs incl. enum-typed field (ctor / read / whole-value
//   rebinding), bare enums, match with arm-side assignments,
//   functions + recursion, closure literal + value capture,
//   string concat / == / len() / str(), ints / floats / bools /
//   hex literals, if / else chains, while over int counters,
//   file write/read round trip.
//
// Deliberately NOT used (broken at HEAD — see audit report):
//   tuples, for-in, enum equality (==), enum values passed as
//   function arguments, str-payload enums printed natively,
//   field assignment, else-if, generics syntax, negative
//   arithmetic results.
// ============================================================

enum St:
    Todo
    Running
    Done
    Failed

struct Task:
    int: id
    str: title
    int: priority
    St: st

fn describe(Task: t):
    let mut lab = "?"
    let mut done = false
    match t.st:
        Todo:
            lab = "TODO"
        Running:
            lab = "RUNNING"
        Done:
            lab = "DONE"
            done = true
        Failed:
            lab = "FAILED"
    println("TASK[" + str(t.id) + "] " + t.title + " prio=" + str(t.priority) + " state=" + lab)
    if done:
        println("  -> archive")

fn fact(int: n):
    if n <= 1:
        return 1
    return n * fact(n - 1)

fn main():
    let owner = "lime"
    println("== TASK MANAGER (owner=" + owner + ") ==")

    // ---- Level 11: closure literal, value capture, invocation ----
    let add10 = fn(int: x):
        return x + 10
    println("CLOSURE=" + str(add10(5)))

    // ---- Level 8/9: tasks (hex literal id) ----
    let mut t1 = Task(0x1, "write audit", 9, Running)
    let st1 = Running
    let mut t2 = Task(0x2, "fix parser", 6, Todo)
    let st2 = Todo

    describe(t1)
    describe(t2)

    // ---- Level 10: transition by whole-value rebinding ----
    t2 = Task(t2.id, t2.title, t2.priority + 4, Done)
    st2 = Done
    describe(t2)

    // ---- statistics (branching, no enum ==) ----
    let mut done_count = 0
    // enum equality is not supported — use match-side assignment instead.
    let mut d1 = false
    match st1:
        Todo:
            d1 = false
        Running:
            d1 = false
        Done:
            d1 = true
        Failed:
            d1 = false
    let mut d2 = false
    match st2:
        Todo:
            d2 = false
        Running:
            d2 = false
        Done:
            d2 = true
        Failed:
            d2 = false
    if d1:
        done_count = done_count + 1
    if d2:
        done_count = done_count + 1
    println("DONE=" + str(done_count))
    println("HIGH=" + str(t1.priority / 8))

    // ---- Level 5: recursion sanity ----
    println("FACT5=" + str(fact(5)))

    // ---- Level 13: deterministic save / read-back round trip ----
    write_file("task_report.txt", "REPORT\n")
    let loaded = read_file("task_report.txt")
    println("ROUNDTRIP=" + str(loaded == "REPORT\n"))

    println("== END ==")
