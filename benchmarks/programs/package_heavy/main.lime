fn lvl(n: int) -> int {
    let l: List<int> = List()
    l.push(n)
    l.push(n + 1)
    let s = string.from_int(n)
    let t = time.now()
    let m: HashMap<int,str> = HashMap(n, s)
    let r = math.abs(n)
    return l.size() + r + m.size()
}
