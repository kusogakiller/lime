fn box<T>(x: T) -> List<T> { let l: List<T> = List(); l.push(x); return l }
fn unbox<T>(l: List<T>) -> T { return l.get(0) }
fn chain<T>(x: T) -> T { return unbox(box(x)) }
fn twice<T>(x: T) -> List<T> { let a = chain(x); let b = chain(a); let l: List<T> = List(); l.push(a); l.push(b); return l }
