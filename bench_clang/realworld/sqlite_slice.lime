// Real-world Phase A: SQLite (C ecosystem) via Charger.
// Proves: headers parsed (291 fn / 52 struct), native artifact prepared,
// opaque handles (sqlite3*), memory lifetime (open -> exec -> close), and the
// exec callback all work from Lime through the prepare-before-build FFI layer.
// No new ABI design — uses the existing Opaque / Callback / native-artifact /
// metadata machinery. The out-param of sqlite3_open and the trailing callback of
// sqlite3_exec are bridged by Charger adapters so Lime gets a clean signature.

extern fn sqlite3_open(String: path) -> Opaque(sqlite3) "lime_out_sqlite3_open"
extern fn sqlite3_exec(Opaque(sqlite3): db, String: sql) -> Int "lime_out_sqlite3_exec"
extern fn sqlite3_changes(Opaque(sqlite3): db) -> Int "sqlite3_changes"
extern fn sqlite3_close(Opaque(sqlite3): db) -> Int "sqlite3_close"

fn main():
    let db = sqlite3_open(":memory:")
    let e1 = sqlite3_exec(db, "CREATE TABLE t(id INTEGER)")
    let e2 = sqlite3_exec(db, "INSERT INTO t VALUES(1)")
    let e3 = sqlite3_exec(db, "INSERT INTO t VALUES(2)")
    let n = sqlite3_changes(db)   # expect 1 (last INSERT affected 1 row)
    print(n)
    print("\n")
    let c = sqlite3_close(db)
    print(c)
    print("\n")
