extern fn lime_get_DirectAnonStruct_c(Opaque(DirectAnonStruct): a0) -> Int "lime_get_DirectAnonStruct_c"
extern fn lime_set_DirectAnonStruct_d(Opaque(DirectAnonStruct): a0, Int: a1) -> Unit "lime_set_DirectAnonStruct_d"
extern fn lime_get_DirectAnonStruct_d(Opaque(DirectAnonStruct): a0) -> Int "lime_get_DirectAnonStruct_d"

