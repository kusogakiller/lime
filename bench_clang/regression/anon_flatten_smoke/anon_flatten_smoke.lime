// Iteration 18 smoke: generic anonymous record flattening.
// Proves each flattened anonymous-struct/union member is addressable and
// round-trips through Charger's generated get/set shims.

extern fn lime_make_DirectAnonStruct() -> Opaque(DirectAnonStruct) "lime_make_DirectAnonStruct"
extern fn lime_set_DirectAnonStruct_a(Opaque(DirectAnonStruct): a0, Int: a1) -> Unit "lime_set_DirectAnonStruct_a"
extern fn lime_get_DirectAnonStruct_a(Opaque(DirectAnonStruct): a0) -> Int "lime_get_DirectAnonStruct_a"
