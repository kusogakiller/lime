// Category C: Function calls — many direct + nested small calls.
fn sq(int: a):
    return a * a

fn add(int: a, int: b):
    return a + b

fn nested(int: a):
    return add(sq(a), sq(a + 1))

fn main():
    let mut int: total = 0
    let mut int: i = 0
    while (i < 20000000):
        total = total + nested(i % 1000)
        i = i + 1
    println(total)
