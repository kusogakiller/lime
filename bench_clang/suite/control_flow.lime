// Category E: Control flow — while loop with nested if/elif/else branches (arithmetic).
fn main():
    let mut int: total = 0
    let mut int: i = 0
    while (i < 50000000):
        if (i % 3 == 0):
            total = total + i
        else:
            if (i % 3 == 1):
                total = total - i
            else:
                if (i % 5 == 0):
                    total = total + (i * 2)
                else:
                    total = total + 1
        i = i + 1
    println(total)
