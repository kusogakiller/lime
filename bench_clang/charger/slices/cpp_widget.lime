// C++ vertical slice: call into prepared libwidget via Charger extern fns.
// Widget fields are public in the test header so the Lime struct layout
// matches the C++ class layout (x_, y_ both Int).
extern fn widget_new(a0: Int, a1: Int) -> Widget "??0Widget@@QEAA@_J0@Z"
extern fn widget_area(self: Widget) -> Int "?area@Widget@@QEBA_JXZ"
extern fn widget_area(self: Widget, a0: Int) -> Int "?area@Widget@@QEBA_J_J@Z"
extern fn widget_get_x(self: Widget) -> Int "?get_x@Widget@@QEBA_JXZ"

struct Widget:
    int: x_
    int: y_

fn main():
    let w = widget_new(3, 4)
    let a1 = widget_area(w)
    print(a1)
    print("\n")
    let a2 = widget_area(w, 2)
    print(a2)
    print("\n")
    let gx = widget_get_x(w)
    print(gx)
    print("\n")
