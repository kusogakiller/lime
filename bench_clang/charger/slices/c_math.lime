// C vertical slice: call into prepared libmathx via Charger extern fns.
extern fn add(a0: Int, a1: Int) -> Int "add"
extern fn make_point(a0: Int, a1: Int) -> Point "make_point"
extern fn point_sum(a0: Point) -> Int "point_sum"
extern fn square(a0: Int) -> Int "square"

struct Point:
    int: x
    int: y

fn main():
    let s = add(3, 4)
    print(s)
    print("\n")
    let p = make_point(2, 5)
    let ps = point_sum(p)
    print(ps)
    print("\n")
    let sq = square(7)
    print(sq)
    print("\n")
