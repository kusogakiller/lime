// C++ inheritance / virtual dispatch vertical slice (#5).
// Lime holds a Base* (Shape*) as an Opaque(Shape) handle and calls the free
// function `shape_area`, which dispatches through the C++ vtable to the
// Derived (Circle) implementation. Lime does NOT implement a vtable — the
// native ABI handling is done by clang (C++ source -> Clang -> native ABI).
// Expected output: 9 (Circle::area = 3*3), proving the derived impl is called
// and not the Shape base stub (which returns -1).

extern fn make_circle(Int: r) -> Opaque(Shape) "?make_circle@@YAPEAVShape@@_J@Z"
extern fn shape_area(Opaque(Shape): s) -> Int "?shape_area@@YA_JPEAVShape@@@Z"
extern fn shape_free(Opaque(Shape): s) -> Unit "?shape_free@@YAXPEAVShape@@@Z"

fn main():
    let s = make_circle(3)
    let a = shape_area(s)   # Circle::area = 3*3 = 9, NOT Shape::area (-1)
    print(a)                # expect 9 (derived impl via vtable)
    print("\n")
    shape_free(s)
