// Iteration 9 regression: callback-table struct (`struct { int (*op)(int); int (*cl)(int); }`).
// Charger must extract the function-pointer fields, surface them as `Callback`-
// typed setters on the opaque handle, and let a Lime function be registered and
// invoked through the table. op adds 10, cl doubles; cbt_invoke(op(x)+cl(x)) with
// x=5 -> (5+10) + (5*2) = 15 + 10 = 25. Generic: no library names in the bridge.
extern fn lime_make_CallbackTable() -> Opaque(CallbackTable) "lime_make_CallbackTable"
extern fn lime_set_CallbackTable_op(Opaque(CallbackTable): a0, Callback: a1) "lime_set_CallbackTable_op"
extern fn lime_set_CallbackTable_cl(Opaque(CallbackTable): a0, Callback: a1) "lime_set_CallbackTable_cl"
extern fn cbt_invoke(Opaque(CallbackTable): a0, Int: a1) -> Int "cbt_invoke"

fn myop(int: a):
    return a + 10

fn mycl(int: a):
    return a * 2

fn main():
    let t = lime_make_CallbackTable()
    lime_set_CallbackTable_op(t, myop)
    lime_set_CallbackTable_cl(t, mycl)
    let r = cbt_invoke(t, 5)       // (5+10) + (5*2) = 25
    print(r)
    print("\n")
